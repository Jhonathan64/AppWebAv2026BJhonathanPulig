<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebAppPoliMusicV3.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Poli Music</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg-dark: #0a0e17;
            --bg-sidebar: #0d1320;
            --bg-card: #141b2d;
            --bg-card-hover: #1a2338;
            --accent-blue: #1ed760;
            --accent-cyan: #00d4ff;
            --accent-electric: #0d6efd;
            --text-primary: #ffffff;
            --text-secondary: #a0aabf;
            --sidebar-width: 240px;
            --player-height: 90px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        /* ---- SIDEBAR ---- */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background-color: var(--bg-sidebar);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            border-right: 1px solid rgba(30, 215, 96, 0.1);
        }

        .sidebar-brand {
            padding: 28px 24px 20px;
            font-size: 20px;
            font-weight: 700;
            color: var(--accent-blue);
            letter-spacing: -0.5px;
        }

        .sidebar-brand .brand-icon {
            display: inline-block;
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            border-radius: 50%;
            margin-right: 10px;
            vertical-align: middle;
            position: relative;
        }

        .sidebar-brand .brand-icon::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 0;
            height: 0;
            border-left: 8px solid var(--bg-dark);
            border-top: 6px solid transparent;
            border-bottom: 6px solid transparent;
            margin-left: 2px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 0 12px;
            overflow-y: auto;
        }

        .sidebar-nav ul {
            list-style: none;
        }

        .sidebar-nav .nav-section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-secondary);
            padding: 20px 12px 8px;
            font-weight: 600;
        }

        .sidebar-nav .nav-item {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 2px;
            transition: background-color 0.2s ease;
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
        }

        .sidebar-nav .nav-item:hover {
            background-color: var(--bg-card-hover);
            color: var(--text-primary);
        }

        .sidebar-nav .nav-item.active {
            background-color: rgba(30, 215, 96, 0.12);
            color: var(--accent-blue);
        }

        .sidebar-nav .nav-item .nav-icon {
            width: 24px;
            height: 24px;
            margin-right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .sidebar-footer {
            padding: 16px 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 12px;
            color: var(--text-secondary);
        }

        .sidebar-footer a {
            color: var(--accent-cyan);
            text-decoration: none;
        }

        /* ---- MAIN CONTENT AREA ---- */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            margin-bottom: var(--player-height);
            min-height: calc(100vh - var(--player-height));
        }

        .main-content {
            padding: 32px 40px;
        }

        .main-content .body-content {
            width: 100%;
        }

        /* ---- HIDDEN BOOTSTRAP NAVBAR (overridden by sidebar) ---- */
        .navbar.bg-dark {
            display: none !important;
        }

        /* ---- FOOTER OVERRIDE ---- */
        .main-content hr {
            display: none;
        }

        .main-content footer {
            display: none;
        }

        /* ---- FORM / ASP.NET OVERRIDES ---- */
        form {
            display: block;
        }

        /* ---- RESPONSIVE ---- */
        @media screen and (max-width: 768px) {
            :root {
                --sidebar-width: 0px;
            }
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            .sidebar.open {
                transform: translateX(0);
                width: 240px;
            }
            .main-content {
                padding: 20px 16px;
            }
        }

        /* ---- INPUT OVERRIDE ---- */
        input, select, textarea {
            max-width: 100%;
        }

        /* ---- TOP NAVIGATION LAYOUT ---- */
        .sidebar {
            position: relative;
            top: auto;
            bottom: auto;
            width: 100%;
            min-height: 44px;
            height: 44px;
            flex-direction: row;
            align-items: center;
            border-right: 0;
            border-bottom: 1px solid rgba(0, 212, 255, 0.22);
            background: #10191d;
        }

        .sidebar-brand {
            padding: 0 12px;
            font-size: 13px;
            font-weight: 500;
            color: #d7dce0;
            white-space: nowrap;
        }

        .sidebar-brand .brand-icon {
            display: none;
        }

        .sidebar-nav {
            display: flex;
            align-items: center;
            padding: 0 12px;
            overflow: visible;
        }

        .sidebar-nav .nav-section-title {
            display: none;
        }

        .sidebar-nav ul {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .sidebar-nav .nav-item {
            padding: 6px 9px;
            margin-bottom: 0;
            white-space: nowrap;
            font-size: 11px;
            font-weight: 400;
            border-radius: 3px;
        }

        .sidebar-nav .nav-item .nav-icon {
            display: none;
        }

        .sidebar-footer {
            display: none;
        }

        .main-wrapper {
            margin-left: 0;
            margin-bottom: 0;
            min-height: calc(100vh - 44px);
        }

        .main-content {
            width: 100%;
            max-width: 1120px;
            margin: 0 auto;
            padding: 34px 40px 48px;
        }

        @media screen and (max-width: 768px) {
            .sidebar {
                min-height: 44px;
                flex-wrap: wrap;
            }

            .sidebar-brand {
                padding: 0 10px;
            }

            .sidebar-nav {
                width: 100%;
                padding: 0 8px 8px;
                overflow-x: auto;
            }

            .sidebar-nav ul {
                width: max-content;
            }

            .main-content {
                padding: 24px 16px 36px;
            }
        }
    </style>
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <!-- ===== SIDEBAR (Spotify-style) ===== -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                PoliMusic - Jhonathan.Pulig
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section-title">Men&uacute; Principal</div>
                <ul>
                    <li><a class="nav-item" runat="server" href="~/"><span class="nav-icon">&#127968;</span> Inicio</a></li>
                    <li><a class="nav-item" runat="server" href="~/Song"><span class="nav-icon">&#127925;</span> Canciones</a></li>
                    <li><a class="nav-item" runat="server" href="~/About"><span class="nav-icon">&#8505;</span> Acerca de</a></li>
                    <li><a class="nav-item" runat="server" href="~/Contact"><span class="nav-icon">&#9993;</span> Contacto</a></li>
                </ul>
                <div class="nav-section-title">Sesi&oacute;n</div>
                <ul>
                    <li><a class="nav-item" runat="server" href="~/Logout"><span class="nav-icon">&#8634;</span> Cerrar Sesi&oacute;n</a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <p>Jhonathan Pulig &copy; <%: DateTime.Now.Year %></p>
            </div>
        </aside>

        <!-- Hidden Bootstrap navbar (kept for ASP.NET compatibility but visually replaced by sidebar) -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/">Poli Music - Jhonathan Pulig</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegacion" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Song">Canciones</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About">Acerca de</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact">Contacto</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Logout">Cerrar Sesion</a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- ===== MAIN CONTENT ===== -->
        <div class="main-wrapper">
            <div class="main-content">
                <div class="body-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
